# Copernicus Data Space Ecosystem
# Crie um OAuth Client no Dashboard do CDSE.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# OpenTopography
# Crie uma API Key gratuita na sua conta do OpenTopography.
OPENTOPOGRAPHY_API_KEY=

# Brazil Data Cube.
# Deixe vazio quando os assets consultados forem públicos.
BDC_TOKEN=

# NASA Earthdata.
# O earthaccess pode solicitar login interativo.
# Se sua instalação aceitar autenticação por ambiente, configure as credenciais
# segundo a documentação vigente do Earthdata.
